# Large data / cached artifacts — never commit these.
# ANCHORED with a leading slash (repo root only). A bare `data/` matches a
# directory named `data` at ANY depth, which silently excluded the source
# package `pattern/data/` — including splits.py, the leakage-critical purge
# logic, and loader.py — from every commit since the initial one. That is how
# the April 2026 "relative label" experiment's code was lost: it lived in an
# untracked file and was overwritten with no history to recover it from.
/cache/
/data/
/runs/
/logs/
wandb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Editors / OS
.DS_Store
.vscode/
.idea/
.claude/
.cursor/
~$*.xlsx
~$*.xls
~$*.docx

# Ad-hoc / temp
*.log
tea_debug.log
/tmp_*
*.tmp
*.bak

# Secrets
.env
.env.*

# Windows / agent lock files
Thumbs.db
.llmchat.lock

# Research outputs: commit the code and docs, never the data they produce.
# Timestamped output dirs (e.g. quality_layer_20260918T064856Z/) and bulk data.
/research/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z/
/research/**/*.parquet
/research/**/*.csv
/research/**/*.png
/research/**/*.pdf
/research/**/*.xlsx
/research/**/report.html

# Research run dirs
/research/**/runs/
